# OS
.DS_Store

# Editor
.idea/
.vscode/

# Planning artifacts stay local, with one exception: the technical-debt record
# is tracked so the no-mistakes pipeline can read and update it. That pipeline
# runs in a disposable worktree built from the pushed branch, never from this
# checkout, so an untracked file is invisible to it and any edit it makes there
# is discarded with the worktree.
#
# The directory itself must be re-included at every level. Git does not descend
# into an excluded directory, so a bare "!.planning/technical-debt/README.md"
# under ".planning/" would never match.
#
# Until now nothing here was ignored at all, so the debt file was shared by
# accident rather than intent, and the first plan or sprint note dropped into
# .planning/ would have been published with it.
.planning/*
!.planning/technical-debt/
.planning/technical-debt/*
!.planning/technical-debt/README.md
